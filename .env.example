# Copia este archivo como .env.local. Nunca subas .env.local al repositorio.

# Supabase → Project Settings → API Keys. Van también en Vercel (Settings → Environment Variables).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Solo para scripts locales (crear cuentas demo). Nunca en Vercel ni en el navegador.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Contraseña común de las cuentas demo (mínimo 10 caracteres).
# Se comparte con la docente solo por el medio acordado, nunca en documentos ni capturas.
DEMO_PASSWORD=cambia-esta-contrasena
